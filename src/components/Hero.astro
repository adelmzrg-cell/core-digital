---
---

<section id="accueil" class="relative min-h-screen flex items-center section-padding pt-32 overflow-hidden">
  <!-- Background orbs -->
  <div class="orb w-[500px] h-[500px] bg-neon/20 top-[-100px] right-[-100px]" style="animation-delay: 0s;"></div>
  <div class="orb w-[400px] h-[400px] bg-blue-600/20 bottom-[-50px] left-[-100px]" style="animation-delay: -5s;"></div>

  <div class="max-w-7xl mx-auto w-full grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    <!-- Text -->
    <div class="reveal">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/10 bg-white/5 mb-8">
        <div class="w-2 h-2 rounded-full bg-neon animate-pulse"></div>
        <span class="text-sm text-gray-light">Agence de marketing digital</span>
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-[1.05] tracking-tight mb-6">
        Core<br/>
        <span class="text-neon glow-text">digital</span>
      </h1>

      <p class="text-2xl sm:text-3xl font-semibold text-white/90 mb-4">
        Plus de visibilité. Plus de clients.
      </p>

      <p class="text-lg text-gray-light max-w-lg mb-10 leading-relaxed">
        Développez votre présence en ligne et attirez de nouveaux clients grâce à des solutions digitales performantes.
      </p>

      <div class="flex flex-col sm:flex-row gap-4">
        <a href="#contact" class="btn-primary text-base px-8 py-4 justify-center">
          Demander un devis
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="https://wa.me/33627237593" target="_blank" rel="noopener"
           class="btn-secondary text-base px-8 py-4 justify-center">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>

    <!-- Laptop Visual -->
    <div class="reveal flex justify-center lg:justify-end" style="transition-delay: 0.2s;">
      <div class="laptop-float relative">
        <!-- Laptop body -->
        <div class="relative w-[340px] sm:w-[440px] lg:w-[520px]">
          <!-- Screen -->
          <div class="bg-dark-card rounded-2xl border border-dark-border overflow-hidden shadow-2xl">
            <!-- Top bar -->
            <div class="flex items-center gap-2 px-4 py-3 border-b border-dark-border">
              <div class="flex gap-1.5">
                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
              </div>
              <div class="flex-1 mx-8">
                <div class="bg-dark/80 rounded-md px-3 py-1 text-xs text-gray-light text-center">core-digital.fr</div>
              </div>
            </div>
            <!-- Dashboard content -->
            <div class="p-5 space-y-4">
              <!-- Stats row -->
              <div class="grid grid-cols-3 gap-3">
                <div class="bg-dark rounded-xl p-3 border border-dark-border">
                  <div class="text-xs text-gray-mid mb-1">Visiteurs</div>
                  <div class="text-lg font-bold text-neon">12.4k</div>
                  <div class="text-xs text-green-400">+23%</div>
                </div>
                <div class="bg-dark rounded-xl p-3 border border-dark-border">
                  <div class="text-xs text-gray-mid mb-1">Leads</div>
                  <div class="text-lg font-bold text-white">847</div>
                  <div class="text-xs text-green-400">+18%</div>
                </div>
                <div class="bg-dark rounded-xl p-3 border border-dark-border">
                  <div class="text-xs text-gray-mid mb-1">Conv.</div>
                  <div class="text-lg font-bold text-white">6.8%</div>
                  <div class="text-xs text-green-400">+5%</div>
                </div>
              </div>
              <!-- Chart placeholder -->
              <div class="bg-dark rounded-xl p-4 border border-dark-border">
                <div class="text-xs text-gray-mid mb-3">Performance mensuelle</div>
                <div class="flex items-end gap-1.5 h-20">
                  {[35, 45, 30, 55, 48, 65, 58, 72, 68, 85, 78, 92].map((h) => (
                    <div class="flex-1 rounded-sm bg-gradient-to-t from-neon/40 to-neon/80 transition-all duration-300"
                         style={`height: ${h}%`}></div>
                  ))}
                </div>
              </div>
              <!-- Bottom row -->
              <div class="grid grid-cols-2 gap-3">
                <div class="bg-dark rounded-xl p-3 border border-dark-border">
                  <div class="text-xs text-gray-mid mb-2">Top sources</div>
                  <div class="space-y-1.5">
                    <div class="flex justify-between text-xs">
                      <span class="text-gray-light">Google Ads</span>
                      <span class="text-neon">42%</span>
                    </div>
                    <div class="flex justify-between text-xs">
                      <span class="text-gray-light">Organique</span>
                      <span class="text-white">31%</span>
                    </div>
                  </div>
                </div>
                <div class="bg-dark rounded-xl p-3 border border-dark-border">
                  <div class="text-xs text-gray-mid mb-2">Budget</div>
                  <div class="text-2xl font-bold text-white">ROI</div>
                  <div class="text-sm text-neon font-semibold">×4.2</div>
                </div>
              </div>
            </div>
          </div>
          <!-- Laptop base -->
          <div class="mx-auto w-[60%] h-3 bg-gradient-to-b from-dark-card to-dark-border rounded-b-xl"></div>
          <div class="mx-auto w-[80%] h-1.5 bg-dark-border/50 rounded-b-2xl"></div>
        </div>
        <!-- Glow beneath laptop -->
        <div class="absolute -bottom-8 left-1/2 -translate-x-1/2 w-[70%] h-16 bg-neon/10 rounded-full blur-2xl"></div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-bounce">
    <span class="text-xs text-gray-mid">Défiler</span>
    <svg class="w-5 h-5 text-gray-mid" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
