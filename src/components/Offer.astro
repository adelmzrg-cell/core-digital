<section class="section-padding relative overflow-hidden">
  <!-- Background glow -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
    <div class="w-[600px] h-[600px] bg-neon/5 rounded-full blur-[120px]"></div>
  </div>

  <div class="max-w-4xl mx-auto text-center relative reveal">
    <span class="text-neon text-sm font-semibold tracking-widest uppercase mb-6 block">Offre</span>

    <h2 class="text-5xl sm:text-6xl lg:text-8xl font-extrabold tracking-tight mb-4">
      Sites web à partir de
    </h2>

    <div class="flex items-baseline justify-center gap-2 mb-6">
      <span class="text-6xl sm:text-7xl lg:text-9xl font-black text-neon glow-text">500€</span>
    </div>

    <p class="text-xl text-gray-light mb-12 max-w-lg mx-auto">
      Devis gratuit et sans engagement. Réponse sous 24h.
    </p>

    <a href="#contact" class="btn-primary text-lg px-10 py-5 inline-flex">
      Demander un devis
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
      </svg>
    </a>
  </div>
</section>
